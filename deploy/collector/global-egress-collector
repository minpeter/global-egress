#!/bin/sh
# global-egress metrics collector.
#
# Follows the fleet convention: read-only inspection, atomic write into the
# node_exporter textfile collector directory. Only GETs against the control API,
# so it can never change pool state.
set -u
# Set CONTROL in the environment (OpenRC: /etc/conf.d/global-egress-metrics). The
# control API binds to the service's own address, not loopback, so there is no
# useful default beyond documenting the shape.
CONTROL="${CONTROL:-http://127.0.0.1:8080}"
OUT_DIR="${OUT_DIR:-/var/lib/node_exporter/textfile_collector}"
OUT="$OUT_DIR/global_egress.prom"
INTERVAL="${INTERVAL:-60}"
CONTROL_TOKEN_FILE="${CONTROL_TOKEN_FILE:-}"
AUTH_CONFIG=

cleanup() {
  [ -z "$AUTH_CONFIG" ] || rm -f "$AUTH_CONFIG"
}
trap cleanup EXIT HUP INT TERM

if [ -n "$CONTROL_TOKEN_FILE" ]; then
  [ -r "$CONTROL_TOKEN_FILE" ] || {
    echo "control token file is not readable" >&2
    exit 1
  }
  token=$(tr -d '\r\n' < "$CONTROL_TOKEN_FILE")
  case "$token" in
    ""|*[!A-Za-z0-9._~-]*)
      echo "control token file contains an invalid token" >&2
      exit 1
      ;;
  esac
  old_umask=$(umask)
  umask 077
  AUTH_CONFIG=$(mktemp "${TMPDIR:-/tmp}/global-egress-collector-curl.XXXXXX")
  umask "$old_umask"
  printf 'header = "Authorization: Bearer %s"\n' "$token" > "$AUTH_CONFIG"
  unset token
fi

control_get() {
  if [ -n "$AUTH_CONFIG" ]; then
    curl --config "$AUTH_CONFIG" "$@"
  else
    curl "$@"
  fi
}

mkdir -p "$OUT_DIR"
chmod 755 "$OUT_DIR"

emit() {
  tmp="$OUT.$$"
  {
    stats=$(control_get -fsS --max-time 8 "$CONTROL/v1/stats" 2>/dev/null)
    echo '# HELP global_egress_up Control API reachable.'
    echo '# TYPE global_egress_up gauge'
    if [ -z "$stats" ]; then
      echo 'global_egress_up 0'
      return 0
    fi
    echo 'global_egress_up 1'

    # One series per numeric field of /v1/stats, named after the field. Fields
    # ending in _total are monotonic, so they are declared as counters and can be
    # rate()-d; everything else is a point-in-time gauge.
    echo "$stats" | sed -n 's/^[[:space:]]*"\([a-z_]*\)": \([0-9][0-9]*\),\{0,1\}$/\1 \2/p' |
      while read -r key value; do
        case "$key" in
          *_total) echo "# TYPE global_egress_$key counter" ;;
          *)       echo "# TYPE global_egress_$key gauge" ;;
        esac
        echo "global_egress_$key $value"
      done

    echo '# HELP global_egress_country_acquisitions_total Successful exit selections by country.'
    echo '# TYPE global_egress_country_acquisitions_total counter'
    control_get -fsS --max-time 8 "$CONTROL/v1/country-acquisitions" 2>/dev/null | awk '
      /"country":/ {
        country = $0
        sub(/.*"country": *"/, "", country)
        sub(/".*/, "", country)
      }
      /"acquisitions":/ && country != "" {
        acquisitions = $0
        gsub(/[^0-9]/, "", acquisitions)
        printf "global_egress_country_acquisitions_total{country=\"%s\"} %s\n", country, acquisitions
        country = ""
      }'

    if extended_metrics=$(control_get -fsS --max-time 8 "$CONTROL/v1/metrics" 2>/dev/null); then
      printf '%s\n' "$extended_metrics"
    else
      echo '# global-egress extended metrics unavailable'
    fi

    # Entry identity and health. The control API pretty-prints, so walk the fields
    # in order and emit once the object is complete: id and region always precede
    # open in the response.
    echo '# HELP global_egress_entry_open Entry tunnel is established.'
    echo '# TYPE global_egress_entry_open gauge'
    echo '# HELP global_egress_entry_bytes_sent_total Bytes relayed client to internet through this entry.'
    echo '# TYPE global_egress_entry_bytes_sent_total counter'
    echo '# HELP global_egress_entry_bytes_received_total Bytes relayed internet to client through this entry.'
    echo '# TYPE global_egress_entry_bytes_received_total counter'
    # Emit when an entry object closes, tracked by brace depth. Keying off a field
    # name breaks as soon as the API reorders its JSON, and matching a bare closing
    # brace fires early on the nested latency object.
    control_get -fsS --max-time 8 "$CONTROL/v1/entries" 2>/dev/null | awk '
      {
        before = depth
        n = gsub(/\{/, "{"); depth += n
        n = gsub(/\}/, "}"); depth -= n
      }
      /"id":/             { id = $0; sub(/.*"id": *"/, "", id); sub(/".*/, "", id) }
      /"region":/         { region = $0; sub(/.*"region": *"/, "", region); sub(/".*/, "", region) }
      /"open":/           { open = ($0 ~ /true/) ? 1 : 0 }
      /"bytes_sent":/     { sent = $0; gsub(/[^0-9]/, "", sent) }
      /"bytes_received":/ { recv = $0; gsub(/[^0-9]/, "", recv) }
      before == 2 && depth == 1 && id != "" {
        printf "global_egress_entry_open{entry=\"%s\",region=\"%s\"} %d\n", id, region, open
        printf "global_egress_entry_bytes_sent_total{entry=\"%s\",region=\"%s\"} %s\n", id, region, (sent == "" ? "0" : sent)
        printf "global_egress_entry_bytes_received_total{entry=\"%s\",region=\"%s\"} %s\n", id, region, (recv == "" ? "0" : recv)
        id = ""; region = ""; open = 0; sent = ""; recv = ""
      }'
  } > "$tmp" 2>/dev/null
  chmod 0644 "$tmp"
  mv "$tmp" "$OUT"
}

if [ "${1:-}" = "once" ]; then
  emit
  exit 0
fi
while :; do
  emit
  sleep "$INTERVAL"
done
